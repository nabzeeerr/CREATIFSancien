RewriteEngine On

# Ajout d'un projet.
RewriteRule ^projects/add/form\.html$ routers/addProjectRouter.php?action=addForm [L,QSA]
RewriteRule ^projects/add/insert\.html$ routers/addProjectRouter.php?action=insert [L,QSA]

# Modification d'un projet.
RewriteRule ^projects/([0-9]+)/([^/]+)/edit/form\.html$ routers/editProjectRouter.php?action=editForm&id=$1&slug=$2 [L,QSA]
RewriteRule ^projects/([0-9]+)/([^/]+)/edit/update\.html$ routers/editProjectRouter.php?action=update&id=$1&slug=$2 [L,QSA]

# Suppression d'un projet (confirmation et action).
RewriteRule ^projects/delete/([0-9]+)/([^/]+)\.html$ routers/deleteProjectRouter.php?action=confirmDelete&id=$1&slug=$2 [L,QSA]

# Détails d'un projet.
RewriteRule ^projects/([0-9]+)/([^/]+)\.html$ routers/projectsRouter.php?action=show&id=$1&slug=$2 [L,QSA]

# Liste des projets.
RewriteRule ^projects/?$ routers/projectsRouter.php [L,QSA]