RewriteEngine On

# Redirige vers le formulaire d'ajout.
RewriteRule ^projects/add/form\.html$ routers/projectsRouter.php?action=addForm [L,QSA]

# Redirige vers l'enregistrement d'un projet.
RewriteRule ^projects/add/insert\.html$ routers/projectsRouter.php?action=insert [L,QSA]

# Affiche le formulaire de modification.
RewriteRule ^projects/([0-9]+)/([^/]+)/edit/form\.html$ routers/projectsRouter.php?action=editForm&id=$1&slug=$2 [L,QSA]

# Enregistre les modifications.
RewriteRule ^projects/([0-9]+)/([^/]+)/edit/update\.html$ routers/projectsRouter.php?action=update&id=$1&slug=$2 [L,QSA]

# Redirige les URLs des projets vers le routeur.
RewriteRule ^projects/([0-9]+)/([^/]+)\.html$ routers/projectsRouter.php?action=show&id=$1&slug=$2 [L,QSA]

# Redirige la liste des projets.
RewriteRule ^projects/?$ routers/projectsRouter.php [L,QSA]